#include <windows.h>

1 RT_MANIFEST "app.manifest"
101 ICON "jaycee.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,2,0
 PRODUCTVERSION 2,2,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JAYCEE"
            VALUE "FileDescription", "JAYCEE Lottery event drawing and presentation system"
            VALUE "FileVersion", "2.2.2"
            VALUE "InternalName", "JAYCEELottery"
            VALUE "OriginalFilename", "JAYCEE Lottery.exe"
            VALUE "ProductName", "JAYCEE Lottery"
            VALUE "ProductVersion", "2.2.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
